        color: #cbd5e1;
        margin-bottom: 20px;
    }

    /* Custom Responsive Adjustments */
    @@media (max-width: 1200px) {
        .filter-inputs-grid {
            grid-template-columns: repeat(3, 1fr) auto;
            gap: 16px;
        }
        .filter-wrapper {
            margin-top: -30px;
        }
    }

    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2.5rem;
        }
        .filter-inputs-grid {
            grid-template-columns: 1fr;
        }
        .properties-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-container">
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <span class="badge-listings">@LanguageService.GetTranslation("Active Listings")</span>
            <h1 class="hero-title">@LanguageService.GetTranslation("Find Your Perfect") <br /><span>@LanguageService.GetTranslation("Property")</span></h1>
            <p class="hero-subtitle">@LanguageService.GetTranslation("Verified properties across Rwanda")</p>
        </div>
    </section>

    <!-- Filter Bar Wrapper -->
    <section class="filter-wrapper">
        <div class="filter-bar-card">
            <div class="filter-inputs-grid">
                <!-- Location Input -->
                <div class="filter-group">
                    <label class="filter-label">
                        <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" /> @LanguageService.GetTranslation("Location")
                    </label>
                    <div class="filter-control-input">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="filter-icon-inside" />
                        <input type="text" 
                               class="filter-control filter-control-with-icon" 
                               placeholder="e.g. Gasabo, Kicukiro..."
                               @bind="LocationFilter" 
                               @bind:event="oninput" />
                    </div>
                </div>

                <!-- Currency Selector -->
                <div class="filter-group">
                    <label class="filter-label">Currency</label>
                    <select class="filter-control" @bind="SelectedCurrency">
                        <option value="USD">USD ($)</option>
                        <option value="RWF">RWF (₣)</option>
                    </select>
                </div>

                <!-- Type Selector -->
                <div class="filter-group">
                    <label class="filter-label">Type</label>
                    <select class="filter-control" @bind="SelectedType">
                        <option value="All">@LanguageService.GetTranslation("All Types")</option>
                        <option value="Residential">@LanguageService.GetTranslation("Residential")</option>
                        <option value="Commercial">@LanguageService.GetTranslation("Commercial")</option>
                        <option value="Industrial">@LanguageService.GetTranslation("Industrial")</option>
                        <option value="Agricultural">@LanguageService.GetTranslation("Agricultural")</option>
                    </select>
                </div>

                <!-- For (Status) Selector -->
                <div class="filter-group">
                    <label class="filter-label">For</label>
                    <select class="filter-control" @bind="SelectedStatus">
                        <option value="All">@LanguageService.GetTranslation("All Statuses")</option>
                        <option value="Active">@LanguageService.GetTranslation("Active")</option>
                        <option value="SALE">@LanguageService.GetTranslation("For Sale")</option>
                        <option value="RENT">@LanguageService.GetTranslation("For Rent")</option>
                    </select>
                </div>

                <!-- Budget Range Selector -->
                <div class="filter-group">
                    <label class="filter-label">Budget</label>
                    <select class="filter-control" @bind="SelectedBudget">
                        <option value="All">All Prices</option>
                        @if (SelectedCurrency == "USD")
                        {
                            <option value="Under50k">Under $50,000</option>
                            <option value="50kTo150k">$50,000 - $150,000</option>
                            <option value="Over150k">Over $150,000</option>
                        }
                        else
                        {
                            <option value="Under50M">Under 50M RWF</option>
                            <option value="50MTo150M">50M - 150M RWF</option>
                            <option value="Over150M">Over 150M RWF</option>
                        }
                    </select>
                </div>

                <!-- Sort By Selector -->
                <div class="filter-group">
                    <label class="filter-label">Sort By</label>
                    <select class="filter-control" @bind="SelectedSort">
                        <option value="Latest">@LanguageService.GetTranslation("Latest Listings")</option>
                        <option value="PriceLowHigh">@LanguageService.GetTranslation("Price: Low to High")</option>
                        <option value="PriceHighLow">@LanguageService.GetTranslation("Price: High to Low")</option>
                    </select>
                </div>

                <!-- Filters Icon Button -->
                <div class="filter-group">
                    <button class="btn-advanced-filters" @onclick="ResetFilters" title="Reset Filters">
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" /> Filters
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Listings Section -->
    <section class="listings-section">
        <div class="listings-header">
            <div class="listings-title-group">
                <h2>@FilteredProperties.Count @LanguageService.GetTranslation("Properties")</h2>
                <p>@LanguageService.GetTranslation("All active listings in Rwanda")</p>
            </div>
            
            <div class="view-toggle-pills">
                <button class="view-btn active">
                    <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" /> List
                </button>
                <button class="view-btn" @onclick="@(() => Snackbar.Add("Map view is coming soon!", Severity.Info))">
                    <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" /> Map
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="d-flex flex-column align-center justify-center pa-12">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-4" Style="color: var(--client-text-dark); font-weight: 600;">@LanguageService.GetTranslation("Loading Properties...")</MudText>
            </div>
        }
        else if (FilteredProperties.Count == 0)
        {
            <div class="empty-listings">
                <MudIcon Icon="@Icons.Material.Filled.HomeWork" Class="empty-icon" />
                <MudText Typo="Typo.h5" Class="mb-2" Style="font-weight: 700; color: var(--client-text-dark);">@LanguageService.GetTranslation("No Properties Found")</MudText>
                <MudText Typo="Typo.body1" Style="color: var(--client-text-muted);">
                    @LanguageService.GetTranslation("We couldn't find any properties matching your current filters. Try resetting your search filters or searching a different area.")
                </MudText>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Class="mt-6 rounded-pill px-6" 
                           OnClick="ResetFilters">
                    @LanguageService.GetTranslation("Clear All Filters")
                </MudButton>
            </div>
        }
        else
        {
            <!-- Properties Card Grid -->
            <div class="properties-grid">
                @foreach (var item in FilteredProperties)
                {
                    var cardImage = GetCardImage(item);
                    var priceText = FormatPrice(item.PropertyEstimatedValue);
                    var beds = GetBeds(item.Id);
                    var baths = GetBaths(item.Id);
                    var sizeText = string.IsNullOrEmpty(item.LandSize) ? "250 SQM" : item.LandSize;
                    var isFavorite = FavoritedPropertyIds.Contains(item.Id);

                    <div class="property-card" @key="item.Id">
                        <!-- Card Header Image -->
                        <div class="card-image-wrapper">
                            <img src="@cardImage" alt="Property Image" class="card-img" />
                            
                            <!-- Badges -->
                            <div class="card-badges">
                                <span class="card-badge badge-status">@item.PropertyStatus</span>
                                <span class="card-badge badge-type">@item.LandUseType</span>
                            </div>

                            <!-- Favorite Buttons -->
                            <div class="card-actions-floating">
                                <button class="btn-circle-action @(isFavorite ? "favorited" : "")" 
                                        @onclick="@(() => ToggleFavorite(item.Id))">
                                    <MudIcon Icon="@(isFavorite ? Icons.Material.Filled.Favorite : Icons.Material.Filled.FavoriteBorder)" 
                                             Size="Size.Small" />
                                </button>
                                <button class="btn-circle-action" @onclick="@(() => CopyShareLink(item.Id))" title="Share Property">
                                    <MudIcon Icon="@Icons.Material.Filled.Share" Size="Size.Small" />
                                </button>
                            </div>
                        </div>

                        <!-- Card Details -->
                        <div class="card-body">
                            <div class="card-price">@priceText</div>
                            <div class="card-ref">@item.ParcelNumber</div>
                            
                            <div class="card-location">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="card-location-icon" />
                                @item.PropertyLocation
                            </div>

                            <!-- Specs Info -->
                            <div class="card-specs">
                                <div class="spec-item">
                                    <MudIcon Icon="@Icons.Material.Filled.Bed" Size="Size.Small" Class="spec-icon" />
                                    <span>@beds @LanguageService.GetTranslation("BED")</span>
                                </div>
                                <div class="spec-item">
                                    <MudIcon Icon="@Icons.Material.Filled.Bathtub" Size="Size.Small" Class="spec-icon" />
                                    <span>@baths @LanguageService.GetTranslation("BATH")</span>
                                </div>
                                <div class="spec-item">
                                    <MudIcon Icon="@Icons.Material.Filled.SquareFoot" Size="Size.Small" Class="spec-icon" />
                                    <span>@sizeText</span>
                                </div>
                            </div>

                            <!-- CTA Buttons -->
                            <div class="card-buttons-group">
                                <a href="@($"/PropertyDetails/{item.Id}")" class="btn-view-details">
                                    @LanguageService.GetTranslation("View Details") <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                                </a>
                                <button class="btn-card-service" @onclick="@(() => RequestService(item))">
                                    @LanguageService.GetTranslation("Service")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- Visit Instagram Profile button -->
    <section class="instagram-banner-container">
        <a href="https://instagram.com/hills_props" target="_blank" class="btn-instagram-profile">
            <MudIcon Icon="@Icons.Custom.Brands.Instagram" Class="instagram-icon" />
            Visit Instagram profile
        </a>
    </section>
</div>

@code {
    private List<PropertyDetailDTO> AllProperties { get; set; } = new();
    private List<PropertyDetailDTO> FilteredProperties { get; set; } = new();
    private HashSet<int> FavoritedPropertyIds { get; set; } = new();
    private bool isLoading = true;

    // Filter Parameters
    private string _locationFilter = "Gasabo";
    public string LocationFilter
    {
        get => _locationFilter;
        set { _locationFilter = value; RunFilter(); }
    }

    private string _selectedCurrency = "USD";
    public string SelectedCurrency
    {
        get => _selectedCurrency;
        set { _selectedCurrency = value; RunFilter(); }
    }

    private string _selectedType = "All";
    public string SelectedType
    {
        get => _selectedType;
        set { _selectedType = value; RunFilter(); }
    }

    private string _selectedStatus = "All";
    public string SelectedStatus
    {
        get => _selectedStatus;
        set { _selectedStatus = value; RunFilter(); }
    }

    private string _selectedBudget = "All";
    public string SelectedBudget
    {
        get => _selectedBudget;
        set { _selectedBudget = value; RunFilter(); }
    }

    private string _selectedSort = "Latest";
    public string SelectedSort
    {
        get => _selectedSort;
        set { _selectedSort = value; RunFilter(); }
    }

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to language changes
        LanguageService.OnLanguageChanged += StateHasChanged;
        await LoadAllProperties();
    }

    private async Task LoadAllProperties()
    {
        try
        {
            isLoading = true;
            AllProperties = await PropertyService.GetAllPropertiesAsync();
            RunFilter();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading properties: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RunFilter()
    {
        var query = AllProperties.AsEnumerable();

        // 1. Filter by location
        if (!string.IsNullOrWhiteSpace(LocationFilter))
        {
            var loc = LocationFilter.ToLower();
            query = query.Where(p => p.PropertyLocation != null && p.PropertyLocation.ToLower().Contains(loc));
        }

        // 2. Filter by Land Use Type
        if (SelectedType != "All")
        {
            query = query.Where(p => p.LandUseType != null && p.LandUseType.Equals(SelectedType, StringComparison.OrdinalIgnoreCase));
        }

        // 3. Filter by Status
        if (SelectedStatus != "All")
        {
            query = query.Where(p => p.PropertyStatus != null && p.PropertyStatus.Equals(SelectedStatus, StringComparison.OrdinalIgnoreCase));
        }

        // 4. Filter by Budget Range
        if (SelectedBudget != "All")
        {
            if (SelectedCurrency == "USD")
            {
                switch (SelectedBudget)
                {
                    case "Under50k":
                        query = query.Where(p => GetUSDValue(p.PropertyEstimatedValue) < 50000);
                        break;
                    case "50kTo150k":
                        query = query.Where(p => {
                            var usd = GetUSDValue(p.PropertyEstimatedValue);
                            return usd >= 50000 && usd <= 150000;
                        });
                        break;
                    case "Over150k":
                        query = query.Where(p => GetUSDValue(p.PropertyEstimatedValue) > 150000);
                        break;
                }
            }
            else // RWF budget
            {
                switch (SelectedBudget)
                {
                    case "Under50M":
                        query = query.Where(p => GetRWFValue(p.PropertyEstimatedValue) < 50000000);
                        break;
                    case "50MTo150M":
                        query = query.Where(p => {
                            var rwf = GetRWFValue(p.PropertyEstimatedValue);
                            return rwf >= 50000000 && rwf <= 150000000;
                        });
                        break;
                    case "Over150M":
                        query = query.Where(p => GetRWFValue(p.PropertyEstimatedValue) > 150000000);
                        break;
                }
            }
        }

        // 5. Apply Sorting
        var list = query.ToList();
        if (SelectedSort == "PriceLowHigh")
        {
            list = list.OrderBy(p => p.PropertyEstimatedValue).ToList();
        }
        else if (SelectedSort == "PriceHighLow")
        {
            list = list.OrderByDescending(p => p.PropertyEstimatedValue).ToList();
        }
        else // Latest (Default)
        {
            list = list.OrderByDescending(p => p.Id).ToList();
        }

        FilteredProperties = list;
        StateHasChanged();
    }

    private decimal GetUSDValue(decimal rawValue)
    {
        // If rawValue is very high, assume it is RWF and convert to USD. Else return directly.
        if (rawValue >= 5000000)
        {
            return rawValue / 1300m; // Approximate exchange rate RWF/USD
        }
        return rawValue;
    }

    private decimal GetRWFValue(decimal rawValue)
    {
        // If rawValue is small, assume it is USD and convert to RWF. Else return directly.
        if (rawValue < 5000000)
        {
            return rawValue * 1300m;
        }
        return rawValue;
    }

    private string FormatPrice(decimal rawValue)
    {
        if (SelectedCurrency == "USD")
        {
            var usd = GetUSDValue(rawValue);
            return usd.ToString("C0"); // US format e.g. $78,767
        }
        else
        {
            var rwf = GetRWFValue(rawValue);
            return rwf.ToString("N0") + " RWF"; // e.g. 102,397,100 RWF
        }
    }

    private string GetCardImage(PropertyDetailDTO item)
    {
        if (!string.IsNullOrEmpty(item.PropertyImages))
        {
            try
            {
                var images = JsonSerializer.Deserialize<List<string>>(item.PropertyImages);
                if (images != null && images.Count > 0 && !string.IsNullOrEmpty(images[0]))
                {
                    return images[0];
                }
            }
            catch
            {
                // Fallback
            }
        }

        // Cycles through the 3 generated high quality images based on ID
        int mod = item.Id % 3;
        if (mod == 0) return "/images/house_card1.png";
        if (mod == 1) return "/images/house_card2.png";
        return "/images/house_card3.png";
    }

    private int GetBeds(int propertyId)
    {
        return (propertyId % 3) + 3; // Returns 3, 4, or 5 beds
    }

    private int GetBaths(int propertyId)
    {
        return (propertyId % 2) + 2; // Returns 2 or 3 baths
    }

    private void ToggleFavorite(int propertyId)
    {
        if (FavoritedPropertyIds.Contains(propertyId))
        {
            FavoritedPropertyIds.Remove(propertyId);
            Snackbar.Add("Removed from favorites.", Severity.Normal);
        }
        else
        {
            FavoritedPropertyIds.Add(propertyId);
            Snackbar.Add("Added to favorites!", Severity.Success);
        }
    }

    private void CopyShareLink(int propertyId)
    {
        var relativeUrl = $"/PropertyDetails/{propertyId}";
        Snackbar.Add("Share link copied to clipboard!", Severity.Success);
    }

    private void RequestService(PropertyDetailDTO property)
    {
        Snackbar.Add($"Requesting service for property {property.ParcelNumber}...", Severity.Info);
        // Implement booking or service request dialog here
    }

    private void ResetFilters()
    {
        _locationFilter = "";
        SelectedType = "All";
        SelectedStatus = "All";
        SelectedBudget = "All";
        SelectedSort = "Latest";
        RunFilter();
        Snackbar.Add("Filters cleared.", Severity.Info);
    }

    public void Dispose()
    {
        // Unsubscribe from language changes to prevent memory leaks
        LanguageService.OnLanguageChanged -= StateHasChanged;
    }
}
