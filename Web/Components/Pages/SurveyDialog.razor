    private async Task onValidSubmit()
    {
        try
        {
            await SurveyService.CreateSurveyAsync(Model);
            Snackbar.Add("Surveys created successfully!", Severity.Info);
            MudDialog.Close(DialogResult.Ok(Model));
        }
        catch(Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }
   
    

