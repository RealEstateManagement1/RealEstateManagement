
@using Application.Interfaces
@using Domain.Entities
@using MudBlazor


@using System.Globalization

@inject NavigationManager NavigationManager

 <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="BackToPropertyTransfers" StartIcon="@Icons.Material.Filled.ArrowBack">
                    Back to List
                </MudButton>
<MudDialog>
    
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2"/> PropertyTransfer Details
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_propertyTransfers == null)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudTextField Label="PropertyTransfer ID" Value="@_propertyTransfers.Id" ReadOnly Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField Label="PropertyId" Value="@_propertyTransfers.PropertyId" ReadOnly Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField Label="SellerId" Value="@_propertyTransfers.SellerId" ReadOnly Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField Label="BuyerId" Value="@_propertyTransfers.BuyerId" ReadOnly Variant="Variant.Outlined" />
                </MudItem>
               
                <MudItem xs="6">
                    <MudTextField Label="TransferType" Value="@_propertyTransfers.TransferType" ReadOnly Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField Label="TransferDate" Value="@_propertyTransfers.TransferDate" ReadOnly Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField Label="Amount" Value="@_propertyTransfers.Amount" ReadOnly Variant="Variant.Outlined" />
                </MudItem>
                             
                    @* <MudItem xs="6">
                        <MudTextField Label="AccountType" Value="@_accounts.AccountType" ReadOnly Variant="Variant.Outlined" />
                </MudItem>  *@
              
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public int Id { get; set; } 
    
    [Inject] IPropertyTransferService PropertyTransferService { get; set; }

    private PropertyTransfer _propertyTransfers;

    protected override async Task OnInitializedAsync()
    {
        _propertyTransfers = await PropertyTransferService.GetPropertyTransferByIdAsync(Id);
    }
    private void Close() => MudDialog.Close();
     private void BackToPropertyTransfers()
    {
        NavigationManager.NavigateTo("/PropertyTransfers");
    }
}