@page "/PropertyDetails/{PropertyId:int}"

@using Application.Interfaces
@using Application.DTO
@using MudBlazor
@using Microsoft.AspNetCore.Authorization

@* @attribute [Authorize] *@

@inject IPropertyService PropertyService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
  
    @* --- STATUS ACTION BAR --- *@
    <div class="d-flex align-center justify-space-between pa-4 mb-4 mt-2 rounded shadow-sm bg-white">
        <MudText Typo="Typo.h5" Color="Color.Primary" Style="font-weight:bold">Property Details</MudText>

        <div class="d-flex gap-4">
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Secondary" 
                       Href="/Properties">
                Back to Properties
            </MudButton>
        </div>
    </div>

    <MudGrid>
        @* 1. PROPERTY INFORMATION *@
        <MudItem xs="12">
            <MudCard Elevation="2" Class="rounded-lg border-l-4" Style="border-left-color: #3b82f6 !important;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Property Information</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <img src="/duture-neza-logo.png" alt="Duture Neza Logo" style="height: 48px; width: auto; object-fit: contain;"/>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    @if (isLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else if (property != null)
                    {
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Parcel Number</MudText>
                                <MudText Typo="Typo.body1"><b>@property.ParcelNumber</b></MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Property Status</MudText>
                                <MudText Typo="Typo.body1" Color="Color.Success"><b>@property.PropertyStatus</b></MudText>
                            </MudItem>
                            
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Estimated Value</MudText>
                                <MudText Typo="Typo.body1"><b>@property.PropertyEstimatedValue.ToString("N0") RWF</b></MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Land Size</MudText>
                                <MudText Typo="Typo.body1">@property.LandSize</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Land Use Type</MudText>
                                <MudText Typo="Typo.body1">@property.LandUseType</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Location</MudText>
                                <MudText Typo="Typo.body1">@property.PropertyLocation</MudText>
                            </MudItem>

                            <MudItem xs="12">
                                <MudDivider Class="my-2" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Document Type</MudText>
                                <MudText Typo="Typo.body1">@property.PropertyDocumentType</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Document Reference</MudText>
                                @if (!string.IsNullOrEmpty(property.PropertyDocuments) && property.PropertyDocuments.StartsWith("data:"))
                                {
                                    <MudButton Href="@property.PropertyDocuments" Target="_blank" Download="PropertyDocument" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download">
                                        Download Document
                                    </MudButton>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body1">@property.PropertyDocuments</MudText>
                                }
                            </MudItem>

                            <MudItem xs="12">
                                <MudDivider Class="my-2" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Created At</MudText>
                                <MudText Typo="Typo.body1">@property.CreatedAt.ToString("g")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Updated At</MudText>
                                <MudText Typo="Typo.body1">@property.UpdatedAt.ToString("g")</MudText>
                            </MudItem>
                        </MudGrid>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Error">Property not found.</MudAlert>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

    </MudGrid>
</MudContainer>

@code {
    [Parameter] 
    public int PropertyId { get; set; }
    
    private PropertyDetailDTO property;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            property = await PropertyService.GetPropertyByIdAsync(PropertyId);
            if (property == null)
            {
                Snackbar.Add("Property not found.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading property: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}
