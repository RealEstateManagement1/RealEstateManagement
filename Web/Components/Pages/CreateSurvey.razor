@page "/surveys/create"
@rendermode InteractiveServer

@using Application.DTO
@using System.ComponentModel.DataAnnotations
@using Application.Interfaces
@using Domain.Entities
@using Application.Services.Surveys
@using MudBlazor
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@inject NavigationManager Navigation
@inject ISurveyService SurveyService

<PageTitle>Create Survey</PageTitle>

<div class="container">
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Create Survey</h3>
            <a href="/surveys" class="btn btn-outline-secondary btn-sm">Back to List</a>
    </div>

       <div class="card">
                    <div class="card-body">
                        <EditForm Model="Model" OnValidSubmit="onValidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger py-2 mb-3" />

                        <MudStack Spacing="2">
                            <MudTextField Label="PropertyId" @bind-Value="Model.PropertyId" For="@(() => Model.PropertyId)" />
                            <MudTextField Label="SurveyorName" @bind-Value="Model.SurveyorName" For="@(() => Model.SurveyorName)" />
                @* <MudItem xs="12" sm="6">
                    <MudSelect T="int" Label="Account type" @bind-Value="Model.AccountTypeId"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               AdornmentIcon="@Icons.Material.Filled.Category" Adornment="Adornment.Start"
                               AdornmentColor="Color.Primary">
                        <MudSelectItem Value="0">Select Account Type</MudSelectItem>
                        @foreach (var account in AccountTypes)
                        {
                            <MudSelectItem Value="@account.Id">@account.AccountTypeName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem> *@
                            <MudTextField Label="SurveyDate" @bind-Value="Model.SurveyDate" For="@(() => Model.SurveyDate)" />
                             <MudTextField Label="Coordinates" @bind-Value="Model.Coordinates" For="@(() => Model.Coordinates)" />
                            
                            
                            <MudButton Variant="Variant.Filled" 
                            ButtonType="ButtonType.Submit" 
                            Style="background-color: #D35400; color: #FFFFFF; font-weight: bold;">
                            Add Survey
                          </MudButton>
                        </MudStack>
                       </EditForm>
                    </div>
        </div>
    </div>
</div>
</div>
@code {
    
    private SurveyCreateDTO Model {get;set;} = new ();

    @* private List<AccountType> AccountTypes = new(); *@
    
    private void onValidSubmit()
    {
        SurveyService.CreateSurveyAsync(Model);
        Navigation.NavigateTo("/surveys");
    }
}