@page "/disputes/create"
@rendermode InteractiveServer

@using Application.DTO
@using System.ComponentModel.DataAnnotations
@using Application.Interfaces
@using Domain.Entities
@using Application.Services.Disputes
@using MudBlazor
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@inject NavigationManager Navigation
@inject IDisputeService DisputeService

<PageTitle>Create Dispute</PageTitle>

<div class="container">
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Create Dispute</h3>
            <a href="/disputes" class="btn btn-outline-secondary btn-sm">Back to List</a>
    </div>

       <div class="card">
                    <div class="card-body">
                        <EditForm Model="Model" OnValidSubmit="onValidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger py-2 mb-3" />

                        <MudStack Spacing="2">
                            <MudTextField Label="PropertyId" @bind-Value="Model.PropertyId" For="@(() => Model.PropertyId)" />
                            <MudTextField Label="Complainant" @bind-Value="Model.Complainant" For="@(() => Model.Complainant)" />
                @* <MudItem xs="12" sm="6">
                    <MudSelect T="int" Label="Account type" @bind-Value="Model.AccountTypeId"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               AdornmentIcon="@Icons.Material.Filled.Category" Adornment="Adornment.Start"
                               AdornmentColor="Color.Primary">
                        <MudSelectItem Value="0">Select Account Type</MudSelectItem>
                        @foreach (var account in AccountTypes)
                        {
                            <MudSelectItem Value="@account.Id">@account.AccountTypeName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem> *@
                            <MudTextField Label="Description" @bind-Value="Model.Description" For="@(() => Model.Description)" />
                            <MudSelect T="string" Label="Status" @bind-Value="Model.Status" For="@(() => Model.Status)" Required="true">
                                @foreach (var c in new List<string> { "Open", "Resolved" })
                                {
                                    <MudSelectItem Value="@c">@c</MudSelectItem>
                                }
                            </MudSelect>
                            
                            <MudButton Variant="Variant.Filled" 
                            ButtonType="ButtonType.Submit" 
                            Style="background-color: #D35400; color: #FFFFFF; font-weight: bold;">
                            Add Dispute
                          </MudButton>
                        </MudStack>
                       </EditForm>
                    </div>
        </div>
    </div>
</div>
</div>
@code {
    
    private DisputeCreateDTO Model {get;set;} = new ();

    @* private List<AccountType> AccountTypes = new(); *@
    
    private void onValidSubmit()
    {
        DisputeService.CreateDisputeAsync(Model);
        Navigation.NavigateTo("/disputes");
    }
}