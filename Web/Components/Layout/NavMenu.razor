@using MudBlazor

<MudNavMenu>
    <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">
        @(!IsMini ? "Dashboard" : "")
    </MudNavLink>

    <MudNavLink Href="/disputes" Icon="@Icons.Material.Outlined.ManageAccounts">
        @(!IsMini ? "Disputes" : "")
    </MudNavLink>

    <MudNavLink Href="/surveys" Icon="@Icons.Material.Outlined.AccountBalanceWallet">
        @(!IsMini ? "Surveys" : "")
    </MudNavLink>

    <MudNavLink Href="/propertyTransfers" Icon="@Icons.Material.Outlined.AccountBalanceWallet">
        @(!IsMini ? "Property Transfer" : "")
    </MudNavLink>
</MudNavMenu>

@code {
    [Parameter] public bool IsMini { get; set; }
}
