</MudDialog>

@code{
    [CascadingParameter]
    
    private IMudDialogInstance MudDialog { get; set; }
    private bool _fullWidth;
    private bool _fitContent;
    [SupplyParameterFromForm(Name = "CreateSurveysForm")]
    private SurveyCreateDTO Model {get;set;} = new ();
    private string ErrorMessage{get;set;}
    @* private List<AccountType> _accountTypes = new ();

      protected override async Task OnInitializedAsync()
      {
          try
          {
               var types = await AccountTypeService.GetAllAccountTypesAsync();
