@page "/dashboard"
@using Application.Interfaces
@using System.Security.Claims
@inject IUserContext UserContext
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>

@if (UserContext.IsAuthenticated && UserContext.ClaimsPrincipal?.IsInRole("Client") == true)
{
    <div class="d-flex flex-column align-center justify-center pa-12" style="min-height: 50vh;">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h6" Class="mt-4">Redirecting to client dashboard...</MudText>
    </div>
}
else
{
    <h1>Hello, world!</h1>
    <p>Welcome to your new app.</p>
}

@code {
    protected override void OnInitialized()
    {
        if (UserContext.IsAuthenticated && UserContext.ClaimsPrincipal?.IsInRole("Client") == true)
        {
            NavigationManager.NavigateTo("/client-dashboard");
        }
    }
}
