@using Infrastructure.Services
@inject DocumentService DocumentService
@inject LandTitleService LandTitleService

<div class="form-panel">
    <div class="panel-header">
        <div>
            <p class="panel-label">Upload document</p>
            <h2>New Document</h2>
        </div>
        <button class="btn btn-outline-black btn-sm" @onclick="Cancel">cancel</button>
    </div>

    <div class="mb-3">
        <label class="form-label">Land Title</label>
        <select class="form-select" @onchange="OnLandTitleChanged">
            <option value="">-- Select Land Title (Optional) --</option>
            @foreach(var lt in landTitles)
            {
                <option value="@lt.Id">@lt.TitleNumber</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Property ID</label>
        <input type="text" class="form-control" @bind="propertyIdStr" />
    </div>

    <div class="mb-3">
        <label class="form-label">Document Type</label>
        <input type="text" class="form-control" @bind="documentType" />
    </div>

    <div class="mb-3">
        <label class="form-label">File</label>
        <InputFile OnChange="HandleSelected" />
        @if (selected != null)
        {
            <small class="text-muted d-block mt-1">Will be saved to: /Uploads/[unique_id]_@selected.Name</small>
        }
    </div>

    <div class="mb-3">
        <label class="form-label">Upload Date</label>
        <input type="date" class="form-control" @bind="uploadDate" />
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <input type="text" class="form-control" @bind="description" />
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-brand" @onclick="UploadAsync" disabled="@(!hasFile)">Upload</button>
        <button class="btn btn-outline-black" @onclick="Cancel">Cancel</button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<Domain.Entities.Document> OnUploaded { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private IBrowserFile? selected;
    private bool hasFile => selected != null;
    private string? description;
    
    private string propertyIdStr = string.Empty;
    private string documentType = string.Empty;
    private DateTime uploadDate = DateTime.Today;
    private Guid? selectedLandTitleId;
    
    private List<Domain.Entities.LandTitle> landTitles = new();

    protected override async Task OnInitializedAsync()
    {
       var result = await LandTitleService.GetAllAsync();
        landTitles = result.ToList();
    }

    private void OnLandTitleChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (Guid.TryParse(val, out var id))
        {
            selectedLandTitleId = id;
            var title = landTitles.FirstOrDefault(t => t.Id == id);
            if (title != null)
            {
                propertyIdStr = title.PropertyId.ToString();
            }
        }
        else
        {
            selectedLandTitleId = null;
            propertyIdStr = string.Empty;
        }
    }

    private void HandleSelected(InputFileChangeEventArgs e)
    {
        selected = e.File;
    }

    private async Task UploadAsync()
    {
        if (selected == null) return;

        Guid? parsedPropertyId = Guid.TryParse(propertyIdStr, out var pid) ? pid : null;
        DateTimeOffset uploadOffset = new DateTimeOffset(uploadDate, TimeSpan.Zero);

        // Limit stream size to a reasonable amount (10 MB here)
        using var stream = selected.OpenReadStream(10 * 1024 * 1024);
        var doc = await DocumentService.SaveFromStreamAsync(stream, selected.Name, selected.ContentType, selected.Size, selectedLandTitleId, description, parsedPropertyId, documentType, uploadOffset);
        await OnUploaded.InvokeAsync(doc);
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }
}
