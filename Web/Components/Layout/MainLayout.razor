@inherits LayoutComponentBase

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <div class="main-content">
        <header class="top-row">
            <div class="brand">
                <NavLink href="/Home" class="brand-link" Match="NavLinkMatch.All">Digital Loan Platform</NavLink>
            </div>

            <div class="top-actions">
                <NavLink href="/dashboard" class="top-link" Match="NavLinkMatch.Prefix">Dashboard</NavLink>
                <NavLink href="/account/logout" class="top-link" Match="NavLinkMatch.All">Logout</NavLink>
            </div>
        </header>

        <article class="content-body">
            @Body
        </article>
    </div>
</div>
